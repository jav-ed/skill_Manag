# build output at the repository root only: an unanchored `dist*` or `fast*` would hide any future
# file or folder whose name starts with these words
/dist*
/fast*

# no npm lock file, except the one that pins the web interface build
package-lock.json
!/Ui/package-lock.json
/Ui/.astro/

# cursor working files
Cursor


.claude/skills

Repos/

# Scratch: disposable agent outputs (doc-start convention).
# Anchored to the repo root: an unanchored "Scratch/" would also ignore the
# tracked cleanup helper in Code/Development/Scratch/.
/Scratch/

# Rust build output
target/
