dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store


.venv
.vscode

**/*.pyc

# build output at the repository root only: an unanchored `dist*` or `fast*` would hide any future
# file or folder whose name starts with these words
/dist*
/fast*

# no npm lock file
package-lock.json

# cursor working files
Cursor


.claude/skills

Repos/

# Go binary
skill_Manag
skill_Manag.exe

# Go test / coverage
*.test
*.out

# Go workspace
go.work
go.work.sum
# Scratch: disposable agent outputs (doc-start convention).
# Anchored to the repo root: an unanchored "Scratch/" would also ignore the
# tracked cleanup helper in Code/Development/Scratch/.
/Scratch/

# Go binary, lowercase build name
skill_manag

# Rust build output
target/
